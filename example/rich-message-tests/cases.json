  {
    "name": "Form Template",
    "trigger": "Form",
    "responseText": "Submit your details",
    "selectors": [
      "input[placeholder=\"Enter your name\"]",
      "input[type=\"password\"]",
      "input[type=\"radio\"][value=\"male\"]",
      "input[type=\"checkbox\"][value=\"metal\"]",
      "button[type=\"submit\"]"
    ],
    "actions": [
      {
        "type": "fill",
        "selector": "input[placeholder=\"Enter your name\"]",
        "label": "Name entered",
        "value": "Release QA"
      },
      {
        "type": "fill",
        "selector": "input[type=\"password\"]",
        "label": "Synthetic password entered",
        "value": "QaOnly42"
      },
      {
        "type": "check",
        "selector": "input[type=\"radio\"][value=\"male\"]",
        "label": "Radio selected",
        "checked": true
      },
      {
        "type": "check",
        "selector": "input[type=\"checkbox\"][value=\"metal\"]",
        "label": "Metal checked",
        "checked": true
      },
      {
        "type": "check",
        "selector": "input[type=\"checkbox\"][value=\"blues\"]",
        "label": "Blues checked",
        "checked": true
      },
      {
        "type": "check",
        "selector": "input[type=\"checkbox\"][value=\"blues\"]",
        "label": "Blues unchecked",
        "checked": false
      },
      {
        "type": "submit",
        "selector": "button[type=\"submit\"], button[data-buttontype=\"submit\"]",
        "label": "Submission payload captured (endpoint not contacted)",
        "url": "<URL>",
        "expectedData": {
          "Name": "Release QA",
          "Password": "QaOnly42",
          "Gender": "male",
          "music_type": [
            "metal"
          ],
          "userDetail": "some_secret_detail"
        }
      }
    ]
  },
