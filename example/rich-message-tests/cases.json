  {
    "name": "Form with Text Area",
    "trigger": "Form text area",
    "responseText": "Form Textarea with Validation",
    "selectors": [
      "textarea[name=\"review\"]",
      "input[placeholder=\"Enter your name\"]",
      "button[type=\"submit\"]"
    ],
    "actions": [
      {
        "type": "fill",
        "selector": "textarea[name=\"review\"]",
        "label": "Invalid review entered",
        "value": "Invalid @ review"
      },
      {
        "type": "invalidSubmit",
        "selector": "button[type=\"submit\"]",
        "label": "Invalid review blocked with visible validation error",
        "url": "https://reqres.in/api/users",
        "errorSelector": ".mck-form-error-review"
      },
      {
        "type": "fill",
        "selector": "textarea[name=\"review\"]",
        "label": "Valid review entered",
        "value": "Kommunicate release testing"
      },
      {
        "type": "fill",
        "selector": "input[placeholder=\"Enter your name\"]",
        "label": "Name entered",
        "value": "Release QA"
      },
      {
        "type": "submit",
        "selector": "button[type=\"submit\"], button[data-buttontype=\"submit\"]",
        "label": "Submission payload captured (endpoint not contacted)",
        "url": "https://reqres.in/api/users",
        "expectedData": {
          "review": "Kommunicate release testing",
          "Name": "Release QA"
        }
      }
    ]
  },
