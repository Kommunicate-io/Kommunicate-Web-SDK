[
  {
    "name": "Buttons Rich message",
    "trigger": "Buttons",
    "responseText": "The oval shaped buttons below are examples of suggested replies",
    "selectors": [
      "button[aria-label=\"Example 1\"]",
      "button[aria-label=\"Example 2\"]",
      "button[aria-label=\"Example for a long button\"]"
    ],
    "actions": [
      {
        "type": "reply",
        "selector": "button[aria-label=\"Example 1\"]",
        "label": "Reply click sends the configured message",
        "expectedText": "Message for Example 1."
      }
    ]
  },
  {
    "name": "Suggested Replies",
    "trigger": "Suggested Replies",
    "responseText": "Do you want more updates?",
    "selectors": [
      "button[aria-label=\"Yes\"]",
      "button[aria-label=\"No\"]"
    ],
    "actions": [
      {
        "type": "reply",
        "selector": "button[aria-label=\"Yes\"]",
        "label": "Reply click sends the configured message",
        "expectedText": "Cool! send me more."
      }
    ]
  },
  {
    "name": "Link Buttons Rich message",
    "trigger": "Link buttons",
    "responseText": "click on the buttons",
    "selectors": [
      "button[aria-label=\"Go To Google\"][data-url^=\"https://www.google.com\"]",
      "button[aria-label=\"Go To Facebook\"][data-url^=\"https://www.facebook.com\"]"
    ],
    "actions": [
      {
        "type": "link",
        "selector": "button[aria-label=\"Go To Google\"]",
        "label": "New-tab link verified (navigation intercepted)",
        "url": "https://www.google.com",
        "target": "_blank"
      },
      {
        "type": "link",
        "selector": "button[aria-label=\"Go To Facebook\"]",
        "label": "Same-tab link verified (navigation intercepted)",
        "url": "https://www.facebook.com",
        "target": "_parent"
      }
    ]
  },
  {
    "name": "Submit Buttons",
    "trigger": "My bill",
    "responseText": "click the pay button",
    "selectors": [
      "button[data-buttontype=\"submit\"]"
    ],
    "actions": [
      {
        "type": "submit",
        "selector": "button[type=\"submit\"], button[data-buttontype=\"submit\"]",
        "label": "Submission payload captured (endpoint not contacted)",
        "url": "https://example.com/book",
        "expectedData": {
          "amount": "1000",
          "description": "movie ticket"
        }
      }
    ]
  },
